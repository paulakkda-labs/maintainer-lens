# Example ONLY. Use your existing credentials if your volumes already exist.
# Copy to .env and change secrets before starting infrastructure.
POSTGRES_USER=maintainer_lens
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=maintainer_lens
RABBITMQ_USER=maintainer_lens
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=maintainer_lens

# Host-mode Python processes (use localhost, not Docker service names).
DATABASE_URL=postgresql+asyncpg://maintainer_lens:change-me-postgres@127.0.0.1:5432/maintainer_lens
RABBITMQ_URL=amqp://maintainer_lens:change-me-rabbitmq@127.0.0.1:5672/maintainer_lens

# Optional. Recommended for GitHub API ingestion.
# Create a fine-grained PAT at:
# https://github.com/settings/personal-access-tokens
# Public repository read access is sufficient for the current V1 scope.
# Leave empty to use GitHub's unauthenticated API rate limit.
GITHUB_TOKEN=

# Required by the default Graph Worker. Use your OpenAI-compatible chat endpoint.
# These settings are not required when tests inject their own investigator.
LLM_BASE_URL=
LLM_MODEL_NAME=
LLM_API_KEY=
# Initial analysis output budget, independent of the configured model/vendor.
LLM_MAX_OUTPUT_TOKENS=4096
# Optional maximum output allowance an operator may approve; leave empty for no
# additional application ceiling. Every approval still supplies a finite integer.
# This does not discover or override your provider's context/output capabilities.
LLM_REVIEW_MAX_OUTPUT_TOKENS=

# Embedding provider, also required by the default Graph Worker.
# Prepared History embeddings must match provider openai-compatible, model and dimensions.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_BATCH_SIZE=20
# Optional; leave empty unless the provider supports explicit output dimensions.
EMBEDDING_REQUEST_DIMENSIONS=
