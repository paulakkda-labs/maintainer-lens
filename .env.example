# Example ONLY. Use your existing credentials if your volumes already exist.
# Copy to .env and change secrets before starting infrastructure.
POSTGRES_USER=maintainer_lens
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=maintainer_lens
REDIS_PASSWORD=change-me-redis
RABBITMQ_USER=maintainer_lens
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=maintainer_lens

# Host-mode Python processes (use localhost, not Docker service names).
DATABASE_URL=postgresql+asyncpg://maintainer_lens:change-me-postgres@127.0.0.1:5432/maintainer_lens
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/0
RABBITMQ_URL=amqp://maintainer_lens:change-me-rabbitmq@127.0.0.1:5672/maintainer_lens
