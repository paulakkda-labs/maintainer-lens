# PostgreSQL
POSTGRES_USER=maintainer_lens
POSTGRES_PASSWORD=replace_me_postgres
POSTGRES_DB=maintainer_lens

# Redis
REDIS_PASSWORD=replace_me_redis

# RabbitMQ
RABBITMQ_USER=maintainer_lens
RABBITMQ_PASSWORD=replace_me_rabbitmq
RABBITMQ_VHOST=maintainer_lens

# Application connection URLs
DATABASE_URL=postgresql+asyncpg://maintainer_lens:replace_me_postgres@127.0.0.1:5432/maintainer_lens
REDIS_URL=redis://:replace_me_redis@127.0.0.1:6379/0
RABBITMQ_URL=amqp://maintainer_lens:replace_me_rabbitmq@127.0.0.1:5672/maintainer_lens

# LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4.1-mini
LLM_API_KEY=replace_with_your_llm_api_key

# Embedding
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=replace_with_your_embedding_api_key